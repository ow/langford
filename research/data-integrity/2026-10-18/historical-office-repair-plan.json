      "source_url": "https://langford.ca/wp-content/uploads/2021/05/20181119-Signed.pdf",
      "native_text_sha256": "eac7aa800ab0a255b1e2a0df4a8c22a5e835c27471dac203e492923035cd3038",
      "source_quote": "Corporate Officer Braden Hutchins swore Mayor Young into office.",
      "pdf_page": 1
    },
