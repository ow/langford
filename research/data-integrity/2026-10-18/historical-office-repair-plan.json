      "source_url": "https://langford.ca/wp-content/uploads/2021/05/20181105-Signed-Minutes-Inaugural-Meeting.pdf",
      "native_text_sha256": "8e5915c1347ed5f9ccb69dad27cf42efdc244960baa94ea9a3663851e8c2a9f1",
      "source_quote": "Chief Administrative Officer Kiedyk (Deputy Corporate Officer) swore into office Councillors D. Blackwell, M.\nSahlstrom, L. Seaton, N. Stewart, L. Szpak, and R. Wade.",
      "pdf_page": 1
    },
    "2018_mayor_oath": {
      "source_file": "archive/langford/Council/2018/11/2018-11-19 Regular Council [legacy]/Minutes/20181119-Signed.pdf",
