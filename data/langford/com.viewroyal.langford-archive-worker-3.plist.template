<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.viewroyal.langford-archive-worker-3</string>

    <key>ProgramArguments</key>
    <array>
        <string>__REPO_ROOT__/apps/pipeline/scripts/run_langford_archive_worker.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO_ROOT__/apps/pipeline</string>

    <key>StandardOutPath</key>
    <string>__REPO_ROOT__/data/langford/logs/archive-worker-3.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO_ROOT__/data/langford/logs/archive-worker-3.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:__HOME__/.local/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
</dict>
</plist>
